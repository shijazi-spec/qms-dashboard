# Memory- and network-conservative npm settings.
#
# Mastra apps install ~870 packages and tight-memory CI / host images
# can OOM-kill `npm install` mid-flight (surfaces as the cryptic
# "npm error Exit handler never called!" — npm being SIGKILL'd by the
# kernel OOM-killer). These flags reduce npm's peak memory + network
# footprint without affecting build correctness:
#   audit=false           — skips post-install vulnerability scan
#                           (saves a large parallel HTTP fan-out)
#   fund=false            — skips the funding-banner walk over every dep
#   prefer-offline=true   — use cache when available, network as fallback
#   legacy-peer-deps=true — don't fail on peer-dep conflicts (Mastra
#                           ecosystem has several historic mismatches)
#   maxsockets=2          — cap concurrent network connections; reduces
#                           the memory spike when many tarballs land at once

audit=false
fund=false
prefer-offline=true
legacy-peer-deps=true
maxsockets=2

args = "npx playwright test tests/postRestoreSweepPanel.spec.ts --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "consultant-approval-prior-viewers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx playwright test tests/consultantApprovalPriorViewers.spec.ts --reporter=line"

[workflows.workflow.metadata]
isValidation = true


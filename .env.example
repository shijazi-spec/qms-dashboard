# WalaPlus Enterprise GRC & Quality Management Platform
# Copy this file to .env and fill in your values
# DO NOT deploy this file — it is for local reference only

# === Required Secrets ===
DATABASE_URL=postgresql://user:password@host:5432/dbname
SESSION_SECRET=your-random-long-string-for-cookie-signing
ADMIN_API_KEY=your-strong-admin-key

# Zoho CRM OAuth (read-only production access)
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token

# === Optional but Recommended ===
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# OpenAI for AI-powered audit insights
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Email delivery via Resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=quality@walaplus.sa

# Leadership KPI feed — shared secret pulled by the WalaPlus Leadership Platform
# (GET /api/kpis/leadership-feed, sent in the X-Feed-Key header). Set the SAME
# value in both Replit apps' Secrets. Must be >= 16 chars or the feed returns 503.
LEADERSHIP_FEED_KEY=your-strong-shared-feed-secret

# Manual "Push to Leadership" button (optional). Set these to push QMS KPI values
# to the Leadership Platform on demand. Without them, the push button reports
# "not configured" and the existing pull feed keeps working.
PLATFORM_WEBHOOK_URL=https://wala-plus-leadership-tool-plus.replit.app/api/integrations/webhook
WEBHOOK_SECRET=
# Optional override of the QMS-code -> Leadership-KPI-UUID map (JSON):
# LEADERSHIP_KPI_MAP={"QM-KPI-002":"<uuid>"}

#!/usr/bin/env bash
# WalaPlus — pre-commit hook
# ----------------------------------------------------------------------------
# Runs the CSP inline-style and inline-handler guardrails locally before each
# commit so developers get instant feedback on violations instead of waiting
# for CI (`npm test`) to fail after a push.
#
# Wired automatically via `npm install` → `prepare` → scripts/install-git-hooks.sh,
# which sets `git config core.hooksPath .githooks` for the local clone.
#
# Bypass (use sparingly, document the reason in the commit message):
#   git commit --no-verify
#
# See docs/Security_Operations_SOP.md §5.5 for the full CSP policy.
# ----------------------------------------------------------------------------

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT" ]; then
  echo "pre-commit: not inside a git checkout, skipping guardrails." >&2
  exit 0
fi
cd "$ROOT"

# Only re-scan when the staged change set actually touches files the
# guardrails inspect (dashboard/ or src/mastra/) — keeps unrelated commits
# instant.
staged_paths=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if [ -n "$staged_paths" ] \
   && ! printf '%s\n' "$staged_paths" | grep -Eq '^(dashboard/|src/mastra/)'; then
  exit 0
fi

failed=0

# Kaspersky quarantines node.exe on at least one machine that commits to this
# repo (the npm/npx shims survive, so `node` is simply missing from PATH). An
# unguarded `node` call here does not degrade — it aborts EVERY commit from
# that machine with "node: command not found", which reads like a guardrail
# violation and teaches people to reach for --no-verify. That is strictly
# worse than not running: --no-verify skips the CSP scans above too.
#
# So: skip the node-based checks when node is absent, say so loudly, and let
# CI enforce them. Same reasoning as the matching block in .githooks/pre-push.
if command -v node >/dev/null 2>&1; then
  HAS_NODE=1
else
  HAS_NODE=0
  echo "→ pre-commit: node not found — HTML-JS syntax and schema-parity guardrails SKIPPED." >&2
  echo "   CI still enforces them; expect a red run if one is violated." >&2
fi

echo "→ pre-commit: running CSP inline-style guardrail…"
if ! bash scripts/check-no-inline-styles.sh; then
  failed=1
fi

echo "→ pre-commit: running CSP inline-handler guardrail…"
if ! bash scripts/check-no-inline-handlers.sh; then
  failed=1
fi

# Dashboard HTML <script> JS syntax guardrail — catches the class of bug
# that took the dashboard down on 2026-05-28 (backticks in an HTML comment
# nested inside a JS template literal closed the outer literal early,
# leaving the page with a fatal SyntaxError that no other check caught).
# Hard gate: a broken <script> in any dashboard/*.html aborts the commit.
if [ "$HAS_NODE" -eq 1 ] && printf '%s\n' "$staged_paths" | grep -Eq '^dashboard/.*\.html$'; then
  echo "→ pre-commit: running dashboard HTML JS syntax guardrail…"
  if ! node scripts/check-dashboard-html-js.mjs; then
    failed=1
  fi
fi

# i18n guardrail — the single most frequent CI breaker in this repo: three
# separate reds in one evening on 2026-09-11/12 (a missing common.save key, a
# ternary key, then two new dynamic call sites). It runs in about a second, so
# catching it here saves a four-minute round trip on a branch several people
# push to. Scoped to commits that touch the files it reads.
if [ "$HAS_NODE" -eq 1 ] \
   && printf '%s\n' "$staged_paths" | grep -Eq '^(dashboard/|public/).*\.(html|js)$|^dashboard/i18n/'; then
  echo "→ pre-commit: running i18n guardrail…"
  if ! node scripts/check-i18n.cjs; then
    failed=1
  fi
fi

# Schema canonical-source parity guardrail — warns when a runtime ALTER
# TABLE ADD COLUMN adds a column that's missing from the canonical
# CREATE TABLE, which is the drift Replit's deploy-time schema-diff
# proposes to "fix" by dropping data from production.
#
# Warning-only HERE — and, as of 2026-09-13, warning-only in CI too.
# .github/workflows/typecheck.yml runs this script without --strict and with
# continue-on-error, so a green CI run does NOT mean there is no drift. The
# only things that fail on it are `npm run check:schema-parity` and
# `npm run check:all` (both pass --strict), and neither tests.yml nor
# typecheck.yml runs them. So if you add an ALTER ... ADD COLUMN, put the
# column in the canonical CREATE TABLE yourself: no automatic gate will stop
# you forgetting. The `|| true` below exists so a pre-existing warning
# elsewhere in the tree cannot block an unrelated commit, not because the
# rule is optional.
if [ "$HAS_NODE" -eq 1 ] && printf '%s\n' "$staged_paths" | grep -Eq '^src/'; then
  echo "→ pre-commit: running schema-parity guardrail (warning mode)…"
  node scripts/check-schema-parity.mjs || true
fi

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  echo "✗ pre-commit: CSP guardrail(s) failed — commit aborted." >&2
  echo "   Fix the violations above, or (rare) bypass with: git commit --no-verify" >&2
  exit 1
fi

exit 0

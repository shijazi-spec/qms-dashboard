modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 1104
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80


# NOTE: PORT is deliberately NOT pinned here.
#
# `[env] PORT = "5000"` used to force the port in EVERY environment, including
# Autoscale deployments. Replit assigns each deployment its own dynamic port and
# health-checks that port, so pinning 5000 made the container listen on 5000
# while the prober hit e.g. 127.0.0.1:1104 — "connection refused" — and the
# deploy failed its healthcheck even though the build and the app were fine.
#
# With this unset, `src/mastra/index.ts` uses `Number(process.env.PORT) || 5000`:
#   - deployment: binds whatever port Replit assigns  ✅
#   - local dev / workspace: PORT is unset, so it falls back to 5000, matching
#     the `localPort = 5000 -> externalPort = 80` mapping above, unchanged.
[env]

[deployment]
deploymentTarget = "autoscale"
run = ["node", "--import=./.mastra/output/instrumentation.mjs", ".mastra/output/index.mjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "secret-redaction"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "i18n"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "post-restore-sweep-panel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "consultant-approval-prior-viewers"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "secret-redaction"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx src/utils/redactSensitiveFields.test.ts && npx tsx tests/aiApprovalRedaction.test.ts && npx tsx tests/aiApprovalRoutesRedaction.test.ts && npx tsx tests/aiApprovalRejectionRedaction.test.ts && npx tsx tests/aiApprovalSweepBackfill.test.ts && npx tsx tests/aiApprovalCredentialWarningsBackfill.test.ts && npx tsx tests/aiTelemetryErrorRedaction.test.ts && npx tsx tests/aiTelemetryMetadataRedaction.test.ts && npx tsx tests/aiToolPolicyBuildPreview.test.ts && npx tsx tests/aiToolPolicyCoverage.test.ts && npx tsx tests/inngestApiRouteIds.test.ts && npx tsx tests/hardenMastraOutputEngines.test.ts && npx tsx tests/hardenMastraOutputLegacyProviderUtils.test.ts && npx tsx tests/hardenMastraOutputOpenaiPin.test.ts && npx tsx scripts/checkStagingProcedureInSync.ts"

[[workflows.workflow]]
name = "i18n"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx playwright test tests/i18n.spec.ts --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "post-restore-sweep-panel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx playwright test tests/postRestoreSweepPanel.spec.ts --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "consultant-approval-prior-viewers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx playwright test tests/consultantApprovalPriorViewers.spec.ts --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[userenv]

[userenv.shared]
# Stops @mastra/core's GatewayRegistry refreshing the provider/model list over
# the network and writing the regenerated
#   node_modules/@mastra/core/dist/llm/model/provider-types.generated.d.ts
# back into node_modules. That file contains model ids like
# 'claude-3.5-sonnet-...' whose numeric prefix TypeScript's parser cannot
# tokenise, so every refresh reintroduced ~77 parse errors and broke
# `npm run check`. It kept coming back after being patched, and kept growing
# (212454 -> 213092 -> 213344 -> 213591 -> 213853 bytes) while @mastra/core
# stayed pinned at 0.24.9 - the app was rewriting a file inside its own
# node_modules.
#
# The refresh defaults ON whenever MASTRA_DEV is set, which Replit sets:
#   autoRefreshEnabled = MASTRA_AUTO_REFRESH_PROVIDERS === "true"
#                     || (MASTRA_AUTO_REFRESH_PROVIDERS !== "false" && isDev)
# so only the literal string "false" disables it.
#
# Safe for us: our agents build providers explicitly via createOpenAI() from
# @ai-sdk/openai-v5 rather than Mastra's model-router strings, so the dynamic
# registry is never on our path. Set in shared (not just development) because
# the deployed app has no use for it either.
#
# Belt and braces, not a replacement for the patch: scripts/patch-mastra-
# provider-types.mjs still runs at precheck, and
# scripts/check-mastra-provider-regeneration.mjs reports if this ever stops
# working.
MASTRA_AUTO_REFRESH_PROVIDERS = "false"
ZOHO_ACCOUNTS_URL = "https://accounts.zoho.com"
ZOHO_API_DOMAIN = "https://www.zohoapis.com"
DATA_MODE = "REAL"
MANUAL_INTAKE_DIR = "./data/manual-intake"
ADMIN_BOOTSTRAP_EMAILS = "s.hijazi@walaplus.com,a.amashah@walaplus.com,m.alharbi@walaplus.com"

[userenv.development]

[userenv.production]
DIRECT_AUDIT_SLACK_NOTIFY = "false"
DIGEST_DASHBOARD_URL = "https://qms-dashboard.replit.app/executive"

[agent]
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_openai_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 360000
